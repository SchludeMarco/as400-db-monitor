# --- Demo-Modus: liefert erfundene Beispieldaten statt einer echten
# AS/400-Verbindung (siehe lib/demoData.js). Fuer eine oeffentliche Live-Demo
# (z.B. verlinkt aus dem README) auf true setzen - dann sind AS400_* unten
# nicht erforderlich. Die Claude-Analyse laeuft weiterhin echt. ---
DEMO_MODE=false

# --- Verbindung zur AS/400 (Mapepire-Server muss dort laufen, Standardport 8076) ---
# Nur relevant, wenn DEMO_MODE=false.
AS400_HOST=deine-as400.firma.local
AS400_PORT=8076
AS400_USER=DEIN_PROFIL
AS400_PASSWORD=DEIN_PASSWORT
# SICHERHEIT: Standardmaessig false lassen (Zertifikat wird geprueft, schuetzt
# vor Man-in-the-Middle). Nur auf true setzen, wenn du das selbstsignierte
# Mapepire-Zertifikat bewusst akzeptierst UND idealerweise per getCertificate()
# vorab gepinnt hast. Siehe https://mapepire-ibmi.github.io/ (Secure Connections).
AS400_IGNORE_UNAUTHORIZED=false

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# --- Server ---
PORT=3000
# Standard: 127.0.0.1 (nur lokal erreichbar, sicherster Default fuer
# Bare-Metal/VM-Betrieb mit Reverse-Proxy auf derselben Maschine).
# In Docker-Setups mit separatem Reverse-Proxy-Container auf 0.0.0.0 setzen
# UND den Container-Port dann NICHT direkt am Host publizieren - siehe
# docker-compose.yml.
HOST=127.0.0.1
# Pflichtfeld: schuetzt /api/* vor unautorisiertem Zugriff. Generieren mit:
#   openssl rand -hex 32
API_KEY=

# Kommagetrennte Liste erlaubter Origins fuer Cross-Origin-Zugriffe
# (leer lassen, wenn das Dashboard vom selben Server ausgeliefert wird).
ALLOWED_ORIGIN=
